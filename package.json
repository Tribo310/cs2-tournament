  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-setup.ts",
    "admin:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-admin.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "db:clear": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-demo.ts --clear"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
